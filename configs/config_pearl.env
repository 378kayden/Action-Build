# 设备基础信息（红米Note12T Pro/pearl）
DEVICE_CODENAME="pearl"
KERNEL_SOURCE="https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git"
KERNEL_BRANCH="kernel-5.10-pearl"
KERNEL_DEFCONFIG="vendor/pearl_defconfig"

# SukiSU-Ultra配置（GKI设备固定）
SUKISU_BRANCH="main"
SUKISU_VERSION="latest"

# 编译工具链（精准匹配你的clang 12.0.5）
TOOLCHAIN="clang"
TOOLCHAIN_VERSION="12.0.5"
TOOLCHAIN_URL="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/tags/android-12.1.0_r32/clang-r416183b.tar.gz"

# 打包工具
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3.git"
ANYKERNEL3_BRANCH="master"

# 强制版本和你的设备完全一致
EXTRA_CFLAGS="-DVERSION=\"5\" -DPATCHLEVEL=\"10\" -DSUBLEVEL=\"136\""
EXTRA_CFLAGS+=" -DANDROID_VERSION=\"12\" -DANDROID_PATCHLEVEL=\"9\""
